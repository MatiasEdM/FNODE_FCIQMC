title

system read
    FCIDUMP-name FCIDUMP_loc 
    electrons 10
    spin-restrict 0
    nonuniformrandexcits pchb localised
    nobrillouintheorem
    sym 0 0 0 0
endsys

calc
       # time 1000
       methods
           method vertex fcimc
       endmethods
   
       tau-values \
           start user-defined 0.001
       #tau-search algorithm conventional maxwalkerbloom 3
   
       seed -7
       # definedet 3-12
         definedet   1-10
       # definedet 3-9  11-13  15-16  18-32 37  46  52   56-57
       # no-changeRef
   
        semi-stochastic
       # pops-core 100000
        fci-core
        davidson-max-iters 100
   
       startSinglePart 1000
       memoryfacspawn 50
       memoryfacpart 20
       totalwalkers 1e5
       shiftdamp 0.2
       stepsshift 10
       allrealcoeff
       realspawncutoff 0.01
       nmcyc 0
   
 #      truncInitiator
 #      addToInitiator 3
   endcalc

integral
endint

logging
    highlypopwrite 10000000
    # print-core-hamil
    popsfile
    hdf5-pops
endlog

end
