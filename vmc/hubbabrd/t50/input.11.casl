General:
   Random seed: timer
Plan:
  VMC-optimization:
    Minimum cycles: 10
    Convergence cycles: 7
System:
  Hubbard model:
      Primitive cell:
        a_1: [  1.0, 1.0 ]
        a_2: [ -1.0, 1.0 ]
      Simulation cell:
        a_1: [ 10.0,  0.0 ]
        a_2: [  0.0, 10.0 ]
      U: #U
      Dump Hamiltonian: FCIDUMP.new
      Dump orbitals: LTSC.new
  netot: 50
VMC:
  nstep: 500000
  nconfig: 100000
Optimization:
  max_niter: 1
Jastrow: wfn.casl
Backflow: wfn.casl
