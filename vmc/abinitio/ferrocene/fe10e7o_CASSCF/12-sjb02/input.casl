System:
  Read Hamiltonian: FCIDUMP_loc
  Read orbitals: LTSC.mat
  Complex orbitals: F
VMC:
  nstep: 500000
  nconfig: 50000
  Report density: T
  Report pair correlation: T
  Sampling distribution: [ Psi^2+offset, log offset: -51.5 ]

Optimization:
  max_niter: 10

Plan:
  VMC-optimization:
#    Minimum cycles: 10
    Maximum cycles: 0

Jastrow: wfn.casl

Backflow: wfn.casl

Multideterminants: wfn.casl

# Dump:
Jastrow dump: jastrow.dat
Backflow dump: backflow.dat
Multideterminant dump: trial_wfn.dat
